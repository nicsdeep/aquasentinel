# Copy to .env.local for local development. Never commit real values.
# Hosted values live in Vercel (Preview = development, Production = production) — see docs/ENVIRONMENTS.md.

# local | development | production
NEXT_PUBLIC_APP_ENV=local

# Supabase project URL and PUBLISHABLE key (safe in the browser only because RLS is enforced).
# For local Supabase (npx supabase start), use the values printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put the Supabase secret key, database password or any SMS/device secrets in NEXT_PUBLIC_* variables.
