{
  "permissions": {
    "allow": [
      "Bash(gh api -X PUT repos/nicsdeep/aquasentinel/pulls/*/merge *)",
      "Bash(gh api -X PUT repos/nicsdeep/aquasentinel/pulls/*/ccr/auto_merge*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
